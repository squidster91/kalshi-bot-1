# Kalshi API
KALSHI_API_KEY_ID=           # From Kalshi dashboard
KALSHI_PRIVATE_KEY_PATH=     # Path to RSA private key PEM file
KALSHI_ENV=demo              # 'demo' or 'production'

# Risk
MAX_CONTRACTS_PER_QUOTE=10
MAX_DAILY_LOSS=250
MAX_EXPOSURE_PER_EVENT=500
MAX_TOTAL_EXPOSURE=2500
MIN_SPREAD=0.02
STARTING_BANKROLL=5000

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DB_PATH=./data/kalshimm.db
